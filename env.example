# Copy this file to .env and fill with your real cookie string.
# Required for: ./bin/kenzitui fetch --id <sprint_id>

# Preferred key
PHAB_COOKIE=phusr=<username>; phsid=<session_id>; VouchCookie=<token>

# Alternative key (also supported)
# KENZITUI_PHAB_COOKIE=phusr=<username>; phsid=<session_id>; VouchCookie=<token>
